{
  "name": "underframe-desktop",
  "productName": "Underframe Desktop",
  "version": "0.1.0",
  "description": "Desktop build planner and damage simulator for Warframe, powered by the Underframe engine.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "npm run build:renderer && electron-builder --win",
    "update-core": "node core/scripts/update.mjs"
  },
  "devDependencies": {
    "@fluentui/react-charts": "9.3.27",
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.344",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.underframe.desktop",
    "productName": "Underframe Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "build/renderer/**/*",
      "core/engine/**/*",
      "core/data/**/*",
      "core/images/**/*",
      "core/manifest.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "src/main/ocr/windows-ocr.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
